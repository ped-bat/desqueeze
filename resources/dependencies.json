{
	"dnglab": {
		"version": "0.8.0",
		"repo": "dnglab/dnglab",
		"binary": "dnglab",
		"installHint": {
			"darwin": "brew install dnglab"
		},
		"assets": {
			"darwin-arm64": {
				"url": "https://github.com/dnglab/dnglab/releases/download/v{{version}}/dnglab-macos-arm64_v{{version}}.zip",
				"find": "dnglab"
			},
			"win32-x64": {
				"url": "https://github.com/dnglab/dnglab/releases/download/v{{version}}/dnglab-win-x64_v{{version}}.zip",
				"find": "dnglab.exe"
			}
		},
		"versionCommand": "--version",
		"versionParser": "split",
		"systemVersionCommand": {
			"darwin": "brew info --json=v2 dnglab | node -e \"process.stdin.on('data',d=>console.log(JSON.parse(d).formulae[0].versions.stable))\""
		},
		"systemUpgradeCommand": {
			"darwin": "brew upgrade dnglab"
		}
	},
	"libraw": {
		"version": "0.22.2",
		"repo": "LibRaw/LibRaw",
		"binary": "dcraw_emu",
		"installHint": {
			"darwin": "brew install libraw"
		},
		"assets": {
			"win32-x64": {
				"url": "https://www.libraw.org/data/LibRaw-{{version}}-Win64.zip",
				"find": "dcraw_emu.exe",
				"siblings": ".dll"
			}
		},
		"versionCommand": null,
		"versionParser": null,
		"systemVersionCommand": {
			"darwin": "brew info --json=v2 libraw | node -e \"process.stdin.on('data',d=>console.log(JSON.parse(d).formulae[0].versions.stable))\""
		},
		"systemUpgradeCommand": {
			"darwin": "brew upgrade libraw"
		}
	}
}
