<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Magnetic Dot Grid</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Science+Gothic:wdth,wght@50..200,100..900&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { width: 100%; height: 100%; overflow: hidden; background: #0a0a0a; }
    canvas { display: block; background: #0a0a0a; }
    .center-text {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-family: 'Science Gothic', sans-serif;
      font-weight: 600;
      font-size: 2.5rem;
      text-transform: uppercase;
      color: #ffffff;
      pointer-events: none;
      z-index: 1;
      letter-spacing: 0.1em;
    }
  </style>
</head>
<body>
  <canvas id="grid"></canvas>
  <div class="center-text">Desquezzing</div>
  <script>
    const canvas = document.getElementById('grid');
    const ctx = canvas.getContext('2d');

    // --- Configuration ---
    const DOT_SPACING = 50;         // px between dots
    const INFLUENCE_RADIUS = 80;    // px — full effect inner radius
    const FALLOFF_RADIUS = 300;      // px — outer edge where effect fades to zero
    const MAX_DOT_RADIUS = 2;       // px at full effect
    const MIN_DOT_RADIUS = 0;     // px at rest (far away)
    const DOT_COLOR = [255, 255, 255]; // RGB
    const EASE_IN_SPEED = 8;          // how fast dots activate (higher = snappier)
    const EASE_OUT_SPEED = 3;          // how fast dots fade back (lower = lingering trail)
    const MOUSE_FOLLOW_SPEED = 10;     // how fast the influence center follows the real cursor
    const REPULSION_STRENGTH = 100;     // max px a dot is pushed away from the cursor
    const REPULSION_RADIUS = 1000;      // px — radius within which dots get pushed

    // --- State B: stretch animation ---
    const LOOP_DURATION = 3;           // total seconds per animation loop
    const STRETCH_AMOUNT = 0.6;         // fraction of DOT_SPACING to stretch (0.6 = 60% extra)
    const STRETCH_DURATION = 1.5;       // seconds for the stretch-out phase
    const SPRING_STIFFNESS = 125;       // spring constant for bounce-back
    const SPRING_DAMPING = 12.5;           // damping (lower = more bouncy)
    const ROW_STRETCH_CENTER = 1;        // stretch multiplier for center rows
    const ROW_STRETCH_EDGE = 0.5;        // stretch multiplier for top/bottom edge rows
    const COL_STRETCH_CENTER = 1;        // stretch multiplier for center columns
    const COL_STRETCH_EDGE = 0;        // stretch multiplier for left/right edge columns
    const SPOTLIGHT_WIDTH = 0.2;          // spotlight width as fraction of canvas width (0.5 = 50%)
    const SPOTLIGHT_HEIGHT = 0.15;         // spotlight height as fraction of canvas height (0.4 = 40%)
    // Gradient control points: [position%, opacity%]
    // position: 0 = center of spotlight ellipse, 100 = outer edge (SPOTLIGHT_RANGE)
    // opacity: 0 = invisible, 100 = fully visible
    const SPOTLIGHT_RANGE = 5;           // how far the gradient extends (multiplier of inner ellipse)
    const SPOTLIGHT_GRADIENT = [
		[20,   0],
		[60,   100],
		[100,   0],
    ];
    const BARREL_STRENGTH = 0.25;          // barrel distortion amount (0 = none, higher = more curve)
    const BARREL_RADIUS = 1;            // fraction of canvas diagonal affected
    const CHROMA_STRENGTH = 3;             // max px offset per RGB channel at full stretch
    const DOT_BLUR_MAX = 4;                // max blur in px for dots outside spotlight (0 = no blur)

    // --- Font axis animation (linked to spring) ---
    const FONT_WEIGHT_REST = 200;           // font weight at rest (100–900)
    const FONT_WEIGHT_STRETCH = 400;        // font weight at full stretch (100–900)
    const FONT_WIDTH_REST = 80;             // font width at rest (50–200)
    const FONT_WIDTH_STRETCH = 120;         // font width at full stretch (50–200)
    const LETTER_SPACING_REST = 5;          // letter-spacing in px at rest
    const LETTER_SPACING_STRETCH = 8;       // letter-spacing in px at full stretch
    const TEXT_SPRING_STIFFNESS = 125;       // text spring constant (lower = slower bounce)
    const TEXT_SPRING_DAMPING = 15;          // text spring damping (lower = more bouncy)

    let mode = 'B'; // 'A' = cursor follow, 'B' = stretch loop
    let mouse = { x: -9999, y: -9999 };
    let smoothMouse = { x: -9999, y: -9999 };
    let mouseActive = false;
    let dots = [];
    let cols, rows;
    let lastTime = 0;

    // State B animation state
    let loopTimer = 0;
    let stretchPhase = 'stretch';
    let stretchTimer = 0;
    let springPos = 0;
    let springVel = 0;
    let textSpringPos = 0;
    let textSpringVel = 0;
    let textStretchPhase = 'stretch';

    const centerTextEl = document.querySelector('.center-text');

    // offscreen canvases for blur compositing (single blur pass)
    const offscreen = document.createElement('canvas');
    const offCtx = offscreen.getContext('2d');
    const maskCanvas = document.createElement('canvas');
    const maskCtx = maskCanvas.getContext('2d');

    // interpolate spotlight gradient control points
    function sampleGradient(t) {
      // t: 0–1 normalized distance (0 = center, 1 = SPOTLIGHT_RANGE edge)
      const pct = t * 100;
      if (pct <= SPOTLIGHT_GRADIENT[0][0]) return SPOTLIGHT_GRADIENT[0][1] / 100;
      if (pct >= SPOTLIGHT_GRADIENT[SPOTLIGHT_GRADIENT.length - 1][0]) return SPOTLIGHT_GRADIENT[SPOTLIGHT_GRADIENT.length - 1][1] / 100;
      for (let i = 0; i < SPOTLIGHT_GRADIENT.length - 1; i++) {
        const [p0, o0] = SPOTLIGHT_GRADIENT[i];
        const [p1, o1] = SPOTLIGHT_GRADIENT[i + 1];
        if (pct >= p0 && pct <= p1) {
          const local = (pct - p0) / (p1 - p0);
          // smooth interpolation between stops
          const smooth = local * local * (3 - 2 * local);
          return (o0 + (o1 - o0) * smooth) / 100;
        }
      }
      return 0;
    }

    function resize() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
      // resize offscreen canvases for blur compositing
      offscreen.width = canvas.width;
      offscreen.height = canvas.height;
      maskCanvas.width = canvas.width;
      maskCanvas.height = canvas.height;
      buildGrid();
    }

    // cubic-bezier(.33, 0, .66, 1) easing
    // Attempt Newton's method to solve bezier for given t
    function cubicBezier(t) {
      const p1x = 0.33, p1y = 0, p2x = 0.66, p2y = 1;
      // solve for parameter u where x(u) = t
      let u = t;
      for (let i = 0; i < 8; i++) {
        const x = 3 * (1 - u) * (1 - u) * u * p1x + 3 * (1 - u) * u * u * p2x + u * u * u - t;
        const dx = 3 * (1 - u) * (1 - u) * p1x + 6 * (1 - u) * u * (p2x - p1x) + 3 * u * u * (1 - p2x);
        if (Math.abs(dx) < 1e-6) break;
        u -= x / dx;
        u = Math.max(0, Math.min(1, u));
      }
      return 3 * (1 - u) * (1 - u) * u * p1y + 3 * (1 - u) * u * u * p2y + u * u * u;
    }

    // cubic-bezier(.40, 0, 1, .60) easing for font axis interpolation
    function fontBezier(t) {
      const p1x = 0.0, p1y = 0, p2x = 1, p2y = 1;
      let u = t;
      for (let i = 0; i < 8; i++) {
        const x = 3 * (1 - u) * (1 - u) * u * p1x + 3 * (1 - u) * u * u * p2x + u * u * u - t;
        const dx = 3 * (1 - u) * (1 - u) * p1x + 6 * (1 - u) * u * (p2x - p1x) + 3 * u * u * (1 - p2x);
        if (Math.abs(dx) < 1e-6) break;
        u -= x / dx;
        u = Math.max(0, Math.min(1, u));
      }
      return 3 * (1 - u) * (1 - u) * u * p1y + 3 * (1 - u) * u * u * p2y + u * u * u;
    }

    function buildGrid() {
      dots = [];
      cols = Math.ceil(canvas.width / DOT_SPACING) + 1;
      rows = Math.ceil(canvas.height / DOT_SPACING) + 1;

      const offsetX = (canvas.width - (cols - 1) * DOT_SPACING) / 2;
      const offsetY = (canvas.height - (rows - 1) * DOT_SPACING) / 2;

      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          dots.push({
            x: offsetX + c * DOT_SPACING,
            y: offsetY + r * DOT_SPACING,
            col: c,  // grid column index
            row: r,  // grid row index
            t: 0, // current animated influence (0→1)
            ox: 0, // current animated offset x
            oy: 0, // current animated offset y
          });
        }
      }
    }

    function draw(now) {
      const dt = Math.min((now - lastTime) / 1000, 0.05);
      lastTime = now;

      ctx.clearRect(0, 0, canvas.width, canvas.height);

      if (mode === 'A') {
        drawModeA(dt);
      } else {
        drawModeB(dt);
      }

      requestAnimationFrame(draw);
    }

    // ========================
    // MODE A — cursor follow
    // ========================
    function drawModeA(dt) {
      if (mouseActive) {
        const mLerp = 1 - Math.exp(-MOUSE_FOLLOW_SPEED * dt);
        smoothMouse.x += (mouse.x - smoothMouse.x) * mLerp;
        smoothMouse.y += (mouse.y - smoothMouse.y) * mLerp;
      }

      // soft radial background glow
      if (mouseActive || smoothMouse.x > -999) {
        const bgGlow = ctx.createRadialGradient(
          smoothMouse.x, smoothMouse.y, 0,
          smoothMouse.x, smoothMouse.y, FALLOFF_RADIUS
        );
        bgGlow.addColorStop(0, 'rgba(255,255,255,0.04)');
        bgGlow.addColorStop(1, 'rgba(255,255,255,0)');
        ctx.fillStyle = bgGlow;
        ctx.fillRect(0, 0, canvas.width, canvas.height);
      }

      const [cr, cg, cb] = DOT_COLOR;

      for (let i = 0; i < dots.length; i++) {
        const dot = dots[i];
        const dx = dot.x - smoothMouse.x;
        const dy = dot.y - smoothMouse.y;
        const dist = Math.sqrt(dx * dx + dy * dy);

        let target;
        if (!mouseActive) {
          target = 0;
        } else if (dist <= INFLUENCE_RADIUS) {
          target = 1;
        } else if (dist >= FALLOFF_RADIUS) {
          target = 0;
        } else {
          const linear = 1 - (dist - INFLUENCE_RADIUS) / (FALLOFF_RADIUS - INFLUENCE_RADIUS);
          target = linear * linear * (3 - 2 * linear);
        }

        const speed = target > dot.t ? EASE_IN_SPEED : EASE_OUT_SPEED;
        dot.t += (target - dot.t) * (1 - Math.exp(-speed * dt));
        if (Math.abs(dot.t - target) < 0.001) dot.t = target;

        let targetOx = 0, targetOy = 0;
        if (mouseActive && dist > 0.1 && dist < REPULSION_RADIUS) {
          const nx = dx / dist;
          const ny = dy / dist;
          const repulsionT = 1 - dist / REPULSION_RADIUS;
          const push = REPULSION_STRENGTH * repulsionT * repulsionT;
          targetOx = nx * push;
          targetOy = ny * push;
        }
        const oSpeed = target > 0 ? EASE_IN_SPEED : EASE_OUT_SPEED;
        const oLerp = 1 - Math.exp(-oSpeed * dt);
        dot.ox += (targetOx - dot.ox) * oLerp;
        dot.oy += (targetOy - dot.oy) * oLerp;

        const drawX = dot.x + dot.ox;
        const drawY = dot.y + dot.oy;

        const radius = MIN_DOT_RADIUS + (MAX_DOT_RADIUS - MIN_DOT_RADIUS) * dot.t;
        const opacity = 0.06 + 0.94 * dot.t;

        if (dot.t > 0.01) {
          const glowRadius = radius * 6;
          const glow = ctx.createRadialGradient(drawX, drawY, 0, drawX, drawY, glowRadius);
          glow.addColorStop(0, `rgba(${cr},${cg},${cb},${(0.10 * dot.t).toFixed(3)})`);
          glow.addColorStop(1, `rgba(${cr},${cg},${cb},0)`);
          ctx.beginPath();
          ctx.arc(drawX, drawY, glowRadius, 0, Math.PI * 2);
          ctx.fillStyle = glow;
          ctx.fill();
        }

        ctx.beginPath();
        ctx.arc(drawX, drawY, radius, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${cr},${cg},${cb},${opacity})`;
        ctx.fill();
      }
    }

    // ========================
    // MODE B — stretch loop
    // ========================
    function drawModeB(dt) {
      const [cr, cg, cb] = DOT_COLOR;

      // advance loop timer
      loopTimer += dt;
      if (loopTimer >= LOOP_DURATION) {
        loopTimer = 0;
        stretchPhase = 'stretch';
        stretchTimer = 0;
        springPos = 0;
        springVel = 0;
        textSpringPos = 0;
        textSpringVel = 0;
        textStretchPhase = 'stretch';
      }

      // advance stretch animation
      let stretchEased = 0;
      if (stretchPhase === 'stretch') {
        stretchTimer += dt;
        const progress = Math.min(stretchTimer / STRETCH_DURATION, 1);
        stretchEased = 1 - Math.pow(1 - progress, 3);
        springPos = stretchEased * STRETCH_AMOUNT;

        if (progress >= 1) {
          stretchPhase = 'spring';
          springPos = STRETCH_AMOUNT;
          springVel = 0;
        }
      } else if (stretchPhase === 'spring') {
        const displacement = springPos;
        const springForce = -SPRING_STIFFNESS * displacement;
        const dampForce = -SPRING_DAMPING * springVel;
        springVel += (springForce + dampForce) * dt;
        springPos += springVel * dt;

        if (Math.abs(springPos) < 0.001 && Math.abs(springVel) < 0.01) {
          springPos = 0;
          springVel = 0;
          stretchPhase = 'idle';
        }
      }

      // text spring: follows same stretch phase but with its own physics
      if (textStretchPhase === 'stretch') {
        textSpringPos = stretchEased * STRETCH_AMOUNT;
        if (stretchPhase === 'spring') {
          textStretchPhase = 'spring';
          textSpringPos = STRETCH_AMOUNT;
          textSpringVel = 0;
        }
      } else if (textStretchPhase === 'spring') {
        const tDisplacement = textSpringPos;
        const tSpringForce = -TEXT_SPRING_STIFFNESS * tDisplacement;
        const tDampForce = -TEXT_SPRING_DAMPING * textSpringVel;
        textSpringVel += (tSpringForce + tDampForce) * dt;
        textSpringPos += textSpringVel * dt;

        if (Math.abs(textSpringPos) < 0.001 && Math.abs(textSpringVel) < 0.01) {
          textSpringPos = 0;
          textSpringVel = 0;
          textStretchPhase = 'idle';
        }
      }

      // compute grid center
      const offsetX = (canvas.width - (cols - 1) * DOT_SPACING) / 2;
      const offsetY = (canvas.height - (rows - 1) * DOT_SPACING) / 2;
      const centerCol = (cols - 1) / 2;
      const centerRow = (rows - 1) / 2;
      const cx = canvas.width / 2;
      const cy = canvas.height / 2;

      // update font variation settings based on text spring position
      const textT = Math.min(Math.abs(textSpringPos) / STRETCH_AMOUNT, 1);
      const fontT = fontBezier(textT);
      const fontWeight = FONT_WEIGHT_REST + (FONT_WEIGHT_STRETCH - FONT_WEIGHT_REST) * fontT;
      const fontWidth = FONT_WIDTH_REST + (FONT_WIDTH_STRETCH - FONT_WIDTH_REST) * fontT;
      const letterSpacing = LETTER_SPACING_REST + (LETTER_SPACING_STRETCH - LETTER_SPACING_REST) * fontT;
      centerTextEl.style.fontVariationSettings = `'wght' ${fontWeight}, 'wdth' ${fontWidth}`;
      centerTextEl.style.letterSpacing = `${letterSpacing}px`;

      // --- Render all dots to offscreen canvas (sharp, no per-dot blur) ---
      offCtx.clearRect(0, 0, offscreen.width, offscreen.height);

      for (let i = 0; i < dots.length; i++) {
        const dot = dots[i];

        // row-based stretch decay (eased)
        const rowNorm = centerRow > 0 ? Math.abs(dot.row - centerRow) / centerRow : 0;
        const rowEased = cubicBezier(rowNorm);
        const rowDecay = ROW_STRETCH_CENTER + (ROW_STRETCH_EDGE - ROW_STRETCH_CENTER) * rowEased;

        // column-based stretch decay (eased)
        const colNorm = centerCol > 0 ? Math.abs(dot.col - centerCol) / centerCol : 0;
        const colEased = cubicBezier(colNorm);
        const colDecay = COL_STRETCH_CENTER + (COL_STRETCH_EDGE - COL_STRETCH_CENTER) * colEased;

        const colOffset = dot.col - centerCol;
        let dotX = offsetX + dot.col * DOT_SPACING + colOffset * DOT_SPACING * springPos * rowDecay * colDecay;
        let dotY = dot.y;

        // barrel distortion: push dots outward, more at edges — scales with stretch
        const barrelT = Math.min(Math.abs(springPos) / STRETCH_AMOUNT, 1);
        const bMax = Math.sqrt(cx * cx + cy * cy) * BARREL_RADIUS;
        const bx = dotX - cx;
        const by = dotY - cy;
        const bd = Math.sqrt(bx * bx + by * by);
        if (barrelT > 0.001 && bd > 0.1 && bd < bMax) {
          const norm = bd / bMax;
          const distortion = 1 + BARREL_STRENGTH * barrelT * norm * norm;
          dotX = cx + bx * distortion;
          dotY = cy + by * distortion;
        }

        // spotlight: elliptical distance from canvas center determines size & opacity
        const spotRx = canvas.width * SPOTLIGHT_WIDTH * 0.5;
        const spotRy = canvas.height * SPOTLIGHT_HEIGHT * 0.5;
        const sdx = (dotX - cx) / spotRx;
        const sdy = (dotY - cy) / spotRy;
        const sdist = Math.sqrt(sdx * sdx + sdy * sdy);

        // map distance to 0–1 range across SPOTLIGHT_RANGE
        const gradientT = Math.min(sdist / SPOTLIGHT_RANGE, 1);
        const vis = sampleGradient(gradientT);

        const dotRadius = MIN_DOT_RADIUS + (MAX_DOT_RADIUS - MIN_DOT_RADIUS) * vis;
        const dotOpacity = 0.06 + 0.94 * vis;

        // glow layer
        if (vis > 0.01) {
          const glowRadius = dotRadius * 6;
          // chromatic aberration on glow: offset R and B channels radially from center
          const chromaT = Math.min(Math.abs(springPos) / STRETCH_AMOUNT, 1);
          const chromaOffset = CHROMA_STRENGTH * chromaT;
          if (chromaOffset > 0.1) {
            const cdx = dotX - cx;
            const cdy = dotY - cy;
            const cd = Math.sqrt(cdx * cdx + cdy * cdy) || 1;
            const cnx = cdx / cd;
            const cny = cdy / cd;
            const rOff = chromaOffset;
            const bOff = -chromaOffset;
            // Red channel glow
            const rxG = dotX + cnx * rOff, ryG = dotY + cny * rOff;
            const glowR = offCtx.createRadialGradient(rxG, ryG, 0, rxG, ryG, glowRadius);
            glowR.addColorStop(0, `rgba(255,0,0,${(0.06 * vis).toFixed(3)})`);
            glowR.addColorStop(1, `rgba(255,0,0,0)`);
            offCtx.beginPath(); offCtx.arc(rxG, ryG, glowRadius, 0, Math.PI * 2); offCtx.fillStyle = glowR; offCtx.fill();
            // Blue channel glow
            const bxG = dotX + cnx * bOff, byG = dotY + cny * bOff;
            const glowB = offCtx.createRadialGradient(bxG, byG, 0, bxG, byG, glowRadius);
            glowB.addColorStop(0, `rgba(0,100,255,${(0.06 * vis).toFixed(3)})`);
            glowB.addColorStop(1, `rgba(0,100,255,0)`);
            offCtx.beginPath(); offCtx.arc(bxG, byG, glowRadius, 0, Math.PI * 2); offCtx.fillStyle = glowB; offCtx.fill();
            // Green channel glow (center)
            const glowG = offCtx.createRadialGradient(dotX, dotY, 0, dotX, dotY, glowRadius);
            glowG.addColorStop(0, `rgba(0,255,0,${(0.06 * vis).toFixed(3)})`);
            glowG.addColorStop(1, `rgba(0,255,0,0)`);
            offCtx.beginPath(); offCtx.arc(dotX, dotY, glowRadius, 0, Math.PI * 2); offCtx.fillStyle = glowG; offCtx.fill();
          } else {
            const glow = offCtx.createRadialGradient(dotX, dotY, 0, dotX, dotY, glowRadius);
            glow.addColorStop(0, `rgba(${cr},${cg},${cb},${(0.10 * vis).toFixed(3)})`);
            glow.addColorStop(1, `rgba(${cr},${cg},${cb},0)`);
            offCtx.beginPath(); offCtx.arc(dotX, dotY, glowRadius, 0, Math.PI * 2); offCtx.fillStyle = glow; offCtx.fill();
          }
        }

        // chromatic aberration on dot: split RGB channels radially
        const chromaT2 = Math.min(Math.abs(springPos) / STRETCH_AMOUNT, 1);
        const chromaOff2 = CHROMA_STRENGTH * chromaT2;
        if (chromaOff2 > 0.1) {
          const cdx = dotX - cx;
          const cdy = dotY - cy;
          const cd = Math.sqrt(cdx * cdx + cdy * cdy) || 1;
          const cnx = cdx / cd;
          const cny = cdy / cd;
          // Red channel — pushed outward
          offCtx.globalCompositeOperation = 'lighter';
          offCtx.beginPath();
          offCtx.arc(dotX + cnx * chromaOff2, dotY + cny * chromaOff2, dotRadius, 0, Math.PI * 2);
          offCtx.fillStyle = `rgba(255,0,0,${dotOpacity * 0.7})`;
          offCtx.fill();
          // Green channel — center
          offCtx.beginPath();
          offCtx.arc(dotX, dotY, dotRadius, 0, Math.PI * 2);
          offCtx.fillStyle = `rgba(0,255,0,${dotOpacity * 0.7})`;
          offCtx.fill();
          // Blue channel — pulled inward
          offCtx.beginPath();
          offCtx.arc(dotX - cnx * chromaOff2, dotY - cny * chromaOff2, dotRadius, 0, Math.PI * 2);
          offCtx.fillStyle = `rgba(0,100,255,${dotOpacity * 0.7})`;
          offCtx.fill();
          offCtx.globalCompositeOperation = 'source-over';
        } else {
          offCtx.beginPath();
          offCtx.arc(dotX, dotY, dotRadius, 0, Math.PI * 2);
          offCtx.fillStyle = `rgba(${cr},${cg},${cb},${dotOpacity})`;
          offCtx.fill();
        }
      }

      // --- Blur compositing: single blur pass ---
      const w = canvas.width;
      const h = canvas.height;

      if (DOT_BLUR_MAX > 0) {
        // Blur layer opacity tied to stretch amount (0 at rest, 1 at full stretch)
        const blurOpacity = Math.min(Math.abs(springPos) / STRETCH_AMOUNT, 1);

        // 1) Always draw sharp dots first
        ctx.drawImage(offscreen, 0, 0);

        if (blurOpacity > 0.005) {
          // 2) Draw blurred version on top with stretch-based opacity
          ctx.save();
          ctx.globalAlpha = blurOpacity;
          ctx.filter = `blur(${DOT_BLUR_MAX}px)`;
          ctx.drawImage(offscreen, 0, 0);
          ctx.restore();

          // 3) Build spotlight alpha mask on maskCanvas
          //    Sharp dots masked by spotlight to "punch through" the blur
          maskCtx.clearRect(0, 0, w, h);
          maskCtx.drawImage(offscreen, 0, 0);
          maskCtx.globalCompositeOperation = 'destination-in';
          const spotRx = w * SPOTLIGHT_WIDTH * 0.5;
          const spotRy = h * SPOTLIGHT_HEIGHT * 0.5;
          const maxR = Math.max(spotRx, spotRy) * SPOTLIGHT_RANGE;
          maskCtx.save();
          maskCtx.translate(cx, cy);
          maskCtx.scale(1, spotRx / spotRy);
          const grad = maskCtx.createRadialGradient(0, 0, 0, 0, 0, maxR);
          for (let i = 0; i < SPOTLIGHT_GRADIENT.length; i++) {
            const [pos, opa] = SPOTLIGHT_GRADIENT[i];
            grad.addColorStop(Math.min(pos / 100, 1), `rgba(255,255,255,${opa / 100})`);
          }
          maskCtx.fillStyle = grad;
          maskCtx.fillRect(-w, -h * (spotRy / spotRx), w * 2, h * 2 * (spotRy / spotRx));
          maskCtx.restore();
          maskCtx.globalCompositeOperation = 'source-over';

          // 4) Draw masked sharp dots on top to restore focus area through blur
          ctx.save();
          ctx.globalAlpha = blurOpacity;
          ctx.drawImage(maskCanvas, 0, 0);
          ctx.restore();
        }
      } else {
        // No blur — just draw offscreen directly
        ctx.drawImage(offscreen, 0, 0);
      }
    }

    function setMode(newMode) {
      mode = newMode;
      if (newMode === 'B') {
        stretchPhase = 'stretch';
        stretchTimer = 0;
        springPos = 0;
        springVel = 0;
        textSpringPos = 0;
        textSpringVel = 0;
        textStretchPhase = 'stretch';
        // reset dot states from mode A
        for (const dot of dots) {
          dot.t = 0;
          dot.ox = 0;
          dot.oy = 0;
        }
      }
    }

    // --- Events ---
    canvas.addEventListener('mousemove', (e) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
      mouseActive = true;
    });

    canvas.addEventListener('mouseleave', () => {
      mouseActive = false;
    });

    document.addEventListener('mouseleave', () => {
      mouseActive = false;
    });

    window.addEventListener('resize', resize);

    // toggle modes with keyboard
    window.addEventListener('keydown', (e) => {
      if (e.key === '1') setMode('A');
      if (e.key === '2') setMode('B');
    });

    // --- Init ---
    resize();
    requestAnimationFrame(draw);
  </script>
</body>
</html>
