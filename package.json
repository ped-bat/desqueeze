{
	"name": "desqueeze",
	"version": "0.0.3",
	"type": "module",
	"main": "out/main/index.js",
	"devDependencies": {
		"electron": "^39.2.7",
		"electron-builder": "^26.0.12",
		"electron-vite": "^5.0.0",
		"vite": "^7.3.0",
		"vitest": "^4.0.18"
	},
	"scripts": {
		"dev": "electron-vite dev",
		"test": "node scripts/check-binaries.js && vitest run",
		"preview": "electron-vite preview",
		"setup": "node scripts/setup-binaries.js",
		"dist": "node scripts/dist.js"
	},
	"build": {
		"appId": "com.desqueeze.app",
		"productName": "Desqueeze",
		"files": [
			"out/**/*"
		],
		"extraResources": [
			{
				"from": "resources/bin",
				"to": "bin",
				"filter": [
					"**/*"
				]
			}
		],
		"mac": {
			"target": "dmg",
			"category": "public.app-category.photography"
		}
	},
	"dependencies": {
		"electron-log": "^5.1.2",
		"exiftool-vendored": "^34.2.0",
		"icc": "^3.0.0",
		"lit": "^3.3.3",
		"p-queue": "^9.1.0",
		"sharp": "^0.34.5"
	}
}
