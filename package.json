{
	"name": "desqueeze",
	"version": "0.0.1",
	"main": "out/main/index.js",
	"devDependencies": {
		"@tailwindcss/vite": "^4.1.18",
		"daisyui": "^5.5.14",
		"electron": "^39.2.7",
		"electron-builder": "^26.0.12",
		"electron-vite": "^5.0.0",
		"tailwindcss": "^4.1.18",
		"vite": "^7.3.0",
		"vitest": "^4.0.18"
	},
	"scripts": {
		"dev": "electron-vite dev",
		"build": "electron-vite build",
		"start": "electron-vite preview",
		"setup": "node setup-binary.js",
		"test": "node scripts/check-binaries.js && vitest run",
		"pack": "electron-vite build && electron-builder --dir",
		"dist": "electron-vite build && electron-builder"
	},
	"build": {
		"appId": "com.desqueeze.app",
		"productName": "Desqueeze",
		"files": [
			"out/**/*"
		],
		"extraResources": [
			{
				"from": "resources/bin",
				"to": "bin",
				"filter": [
					"**/*"
				]
			}
		],
		"mac": {
			"target": "dmg",
			"category": "public.app-category.photography"
		},
		"win": {
			"target": "nsis"
		},
		"linux": {
			"target": "AppImage"
		}
	},
	"dependencies": {
		"electron-log": "^5.1.2",
		"exiftool-vendored": "^34.2.0",
		"icc": "^3.0.0",
		"p-queue": "^9.1.0",
		"sharp": "^0.34.5"
	}
}
